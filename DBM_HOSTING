<body>

<div class="background"></div>

<!-- NAVBAR -->
<nav class="navbar">

    <div class="logo">
        Discord
        <span>Board</span>
        Marketplace
    </div>

    <div class="nav-links">

        <a href="index.html">
            Home
        </a>

        <a href="bots.html">
            Bots
        </a>

        <a href="hosting.html">
            Hosting
        </a>

        <a href="support.html">
            Support
        </a>

        <a
            href="cart.html"
            class="cart-button"
        >
            🛒 Cart
        </a>

    </div>

</nav>


<!-- HEADER -->
<section class="header">

    <h1>
        Premium
        <span>Hosting</span>
    </h1>

    <p>
        Reliable hosting solutions
        for your Discord bots and projects.
    </p>

</section>


<!-- HOSTING -->
<section class="hosting-container">

    <div
        class="hosting-grid"
        id="hostingGrid"
    ></div>


    <div
        class="empty"
        id="emptyMessage"
    >

        <h2>
            No Hosting Available
        </h2>

        <p>
            Hosting products will appear here
            when they are added from the Owner Panel.
        </p>

    </div>

</section>


<!-- TOAST -->
<div
    class="toast"
    id="toast"
>
    Added to cart!
</div>


<!-- FOOTER -->
<footer>

    <p>
        © 2026 Discord Board Marketplace.
        All rights reserved.
    </p>

</footer>


<script>

/* =========================================
   LOAD HOSTING FROM OWNER PANEL
========================================= */

let hostingProducts = JSON.parse(
    localStorage.getItem(
        "DBM_HOSTING"
    )
) || [];


/* =========================================
   LOAD CART
========================================= */

let cart = JSON.parse(
    localStorage.getItem(
        "DBM_CART"
    )
) || [];


/* =========================================
   DISPLAY HOSTING
========================================= */

function renderHosting() {

    const grid =
        document.getElementById(
            "hostingGrid"
        );

    const empty =
        document.getElementById(
            "emptyMessage"
        );


    grid.innerHTML = "";


    if (
        hostingProducts.length === 0
    ) {

        empty.style.display =
            "block";

        return;

    }


    empty.style.display =
        "none";


    hostingProducts.forEach(
        product => {

            const card =
                document.createElement(
                    "div"
                );


            card.className =
                "hosting-card";


            const image =
                product.image ||
                "https://placehold.co/800x500/5865f2/ffffff?text=Hosting";


            const stock =
                Number(
                    product.stock
                ) || 0;


            card.innerHTML = `

                <img
                    class="hosting-image"
                    src="${escapeHTML(image)}"
                    alt="${escapeHTML(product.name)}"
                    onerror="
                        this.src='https://placehold.co/800x500/5865f2/ffffff?text=Hosting'
                    "
                >

                <div class="hosting-content">

                    <h2>
                        ${escapeHTML(
                            product.name
                        )}
                    </h2>

                    <p class="hosting-description">

                        ${escapeHTML(
                            product.description ||
                            "Premium hosting service."
                        )}

                    </p>

                    <div class="hosting-price">

                        €${Number(
                            product.price
                        ).toFixed(2)}

                    </div>

                    <div class="hosting-stock">

                        ${
                            stock > 0
                            ? "🟢 In Stock: " + stock
                            : "🔴 Out of Stock"
                        }

                    </div>

                    <button
                        class="add-cart"
                        onclick="
                            addToCart(
                                ${product.id}
                            )
                        "
                        ${stock <= 0 ? "disabled" : ""}
                    >

                        🛒 Add to Cart

                    </button>

                </div>

            `;


            grid.appendChild(
                card
            );

        }
    );

}


/* =========================================
   ADD TO CART
========================================= */

function addToCart(
    productId
) {

    const product =
        hostingProducts.find(
            item =>
                item.id === productId
        );


    if (!product) {

        alert(
            "Hosting product not found."
        );

        return;

    }


    const stock =
        Number(
            product.stock
        ) || 0;


    if (stock <= 0) {

        alert(
            "This hosting product is out of stock."
        );

        return;

    }


    /*
       IMPORTANT

       We save the product type as "hosting"
       so cart.html knows that this is
       a hosting product.
    */


    const existing =
        cart.find(
            item =>
                item.id === product.id &&
                item.type === "hosting"
        );


    if (existing) {

        if (
            existing.quantity >=
            stock
        ) {

            alert(
                "You cannot add more than the available stock."
            );

            return;

        }


        existing.quantity++;

    } else {

        cart.push({

            id:
                product.id,

            type:
                "hosting",

            name:
                product.name,

            price:
                Number(
                    product.price
                ),

            image:
                product.image || "",

            description:
                product.description || "",

            quantity:
                1

        });

    }


    localStorage.setItem(

        "DBM_CART",

        JSON.stringify(
            cart
        )

    );


    showToast(
        "✅ Hosting added to cart!"
    );

}


/* =========================================
   TOAST
========================================= */

function showToast(
    message
) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    setTimeout(
        () => {

            toast.classList.remove(
                "show"
            );

        },
        2500
    );

}


/* =========================================
   ESCAPE HTML
========================================= */

function escapeHTML(
    text
) {

    return String(
        text
    )

    .replace(
        /&/g,
        "&amp;"
    )

    .replace(
        /</g,
        "&lt;"
    )

    .replace(
        />/g,
        "&gt;"
    )

    .replace(
        /"/g,
        "&quot;"
    )

    .replace(
        /'/g,
        "&#039;"
    );

}


/* =========================================
   START
========================================= */

renderHosting();

</script>

</body>
</html>
