/* HEADER */
.header {
    width: 92%;
    max-width: 1100px;

    margin: 80px auto 40px;

    text-align: center;
}

.header h1 {
    font-size: clamp(40px, 7vw, 75px);
    margin-bottom: 20px;
}

.header h1 span {
